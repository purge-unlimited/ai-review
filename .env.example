# Backend selection: auto | cloud | local
AI_REVIEW_BACKEND=auto

# Optional cloud override. If omitted, the server can discover a provider from
# $CODEX_HOME/config.toml. Never commit a real API key.
AI_REVIEW_CLOUD_BASE_URL=
AI_REVIEW_CLOUD_MODEL=
AI_REVIEW_CLOUD_API_KEY=

# Local OpenAI-compatible endpoint.
AI_REVIEW_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
AI_REVIEW_LOCAL_MODEL=qwen3:8b
AI_REVIEW_LOCAL_API_KEY=

# Optional auto-start command. Leave empty if another process manages the model.
AI_REVIEW_LOCAL_AUTOSTART=auto
AI_REVIEW_LOCAL_NODE=
AI_REVIEW_LOCAL_SERVER=
AI_REVIEW_LOCAL_START_WAIT_MS=120000

# Request limits.
AI_REVIEW_TIMEOUT_MS=180000
